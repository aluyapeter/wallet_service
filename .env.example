# --- Database ---
# Note: Port 5433 is used here assuming you mapped it in docker-compose.
# If running standard local postgres, change to 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wallet_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wallet_db

# --- Security ---
# Generate a secure key: `openssl rand -hex 32`
SECRET_KEY=change_this_to_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- OAuth (Google) ---
# Get these from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Payments (Paystack) ---
# Use your "Test" keys from the Paystack Dashboard
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# --- Redis ---
# If running via Docker, this is usually okay. 
# If getting connection errors, try 'redis://redis:6379/0'
REDIS_URL=redis://localhost:6379/0

# --- Email Settings (SMTP) ---
# Note: For Gmail, use an "App Password", not your login password.
# Port 465 is required for the SSL implementation in tasks.py
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=WalletService